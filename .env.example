# ---- Copy this file to .env and fill in the values ----

# Groq chatbot: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Sign-In: Google Cloud Console > APIs & Services > Credentials >
# Create OAuth client ID > "Web application".
# Add  http://localhost:8000  to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Long random string used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Lets people try the app without Google. Set to false in production.
ALLOW_GUEST_LOGIN=true
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Optional
# DATABASE_URL=sqlite:///./data/waveflow.db        # or postgresql+psycopg://user:pass@host/db
# MAX_UPLOAD_MB=40
# MAX_AUDIO_SECONDS=300

# Alternative: put these values in api_keys.txt (local only; never commit real secrets).
